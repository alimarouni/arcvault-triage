# ---- LLM provider -----------------------------------------------------------
# Groq free tier: https://console.groq.com  (no credit card required)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_replace_me
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# ---- Pipeline tuning --------------------------------------------------------
# Records below this confidence are escalated to human review (Step 6).
CONFIDENCE_THRESHOLD=0.70
# A disputed billing amount at or above this (USD) forces escalation.
BILLING_ESCALATION_USD=500
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3

# ---- Optional downstream sink ----------------------------------------------
# Paste a https://webhook.site/#!/<uuid> unique URL here to mirror records to a
# "downstream system". Leave blank to write to ./output only.
WEBHOOK_SINK_URL=

PORT=3000

# Model tiering: the briefing call runs on a smaller model (cheaper, faster,
# and on a separate provider rate-limit bucket).
LLM_SUMMARY_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low

# Client-side rolling token budget, set below the provider ceiling so the
# pipeline paces itself instead of discovering the limit via 429s.
# Groq free tier on gpt-oss-120b is 8000 TPM.
LLM_TPM_BUDGET=6500
